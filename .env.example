# Copy to .env and load it (e.g. `set -a; source .env; set +a`) before running.
DATABASE_URL=sqlite:///./dropkit.db
JWT_SECRET=generate-a-long-random-string
BASE_URL=http://localhost:8000
SCHEDULER_INTERVAL_SECONDS=30

# Leave these blank to print messages to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM=drops@yourdomain.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
